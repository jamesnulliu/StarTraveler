#version 460
// Hybrid renderer, temporal pass (one layer per dispatch): reproject the
// layer's history with its motion vectors, keep the taps that saw the same
// surface (instance, depth, normal), and add this frame's samples.
//
// The history holds means weighted by sample count (rgb, a = samples). While
// nothing moves the count is unbounded: the means converge like the reference
// accumulation. While things move it is capped (fewer samples for what smooth
// surfaces let through), and keeps less where the temporal gradients say the
// light changed, like where a shadow moved on (A-SVGF, Schied et al., HPG
// 2018; of reflections, what they reflect). The primary layer also keeps the
// means of its albedo and emission: the lighting is divided by the albedo only
// after accumulating, so edges anti-aliased by the jitter stay exact. The direct
// layer keeps its unshadowed light as the albedo (direct.comp): the shadowed
// light divided by it is how much of it arrives; and as the emission, a mean of
// the last few frames' (kRecentUnshadowed; still, of all of them), what the
// composite multiplies it by: it follows the lights, and edges stay anti-aliased.
//
// TraceResolution::Half: a pixel not traced this frame accumulates nothing (its
// own samples only), and borrows from the traced pixels around it on the same
// surface (borrow): their reflections' motion and guides, and their samples as
// the filter's input: only those until it has samples of its own (new, just
// uncovered), else as one frame of its own (they show the more, the less of its
// history the gradients left).
//
// Reflections (the glass and specular layers) are reprojected from where
// their image was, which moves unlike the surface (hybrid_trace.comp,
// virtualMotion), if that held the light of what is reflected there now
// (reflection guides; historyOf). The motion is an estimate: while things move,
// the history of the primary
// surfaces' sharp reflections is also clamped to this frame's samples around
// the pixel (clampToFrame). Not the panes': what they reflect is often a few
// bright samples among dark ones (a canopy reflecting the cockpit, which
// reflects the light), which the samples around a pixel mostly miss; clamped,
// it lost half its light. Their guides are enough to keep them from trailing.
//
// Output: the filter input, lighting (rgb) and the variance of its mean (a).

#extension GL_GOOGLE_include_directive : require

#define STARCORE_NO_RAY_QUERY
#include "hybrid.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Specialization constant 0: some pixels are not traced every frame
// (TraceResolution::Half) and borrow; compiled out of the pipeline for Full
// (the registers it takes would slow it down).
layout(constant_id = 0) const uint kBorrowingConstant = 1u;
const bool kBorrowing = kBorrowingConstant != 0u;

layout(push_constant) uniform Pass
{
    uint layer;  // kLayer*: the primary one has albedo and emission, the direct one albedo.
}
pass;

// Bindings 0-2 and 4-6 are the scene's (hybrid.glsl, scene.glsl).
layout(set = 0, binding = 3, rgba32ui) uniform readonly uimage2D guide;
// Of the layer's surface (the primary one for the specular layer).
layout(set = 0, binding = 7, rgba32f) uniform readonly image2D motion;
layout(set = 0, binding = 8, rgba32ui) uniform readonly uimage2D previousGuide;
layout(set = 0, binding = 9, rgba32f) uniform readonly image2D noisy;
layout(set = 0, binding = 10, rgba16f) uniform readonly image2D frameAlbedo;
layout(set = 0, binding = 11, rgba16f) uniform readonly image2D frameEmission;
layout(set = 0, binding = 12, rgba32f) uniform readonly image2D previousColor;
// Full precision: the composite multiplies by exactly what the lighting was divided by.
layout(set = 0, binding = 13, rgba32f) uniform readonly image2D previousAlbedo;
layout(set = 0, binding = 14, rgba16f) uniform readonly image2D previousEmission;
layout(set = 0, binding = 15, rg32f) uniform readonly image2D previousMoments;
layout(set = 0, binding = 16, rgba32f) uniform writeonly image2D color;
layout(set = 0, binding = 17, rgba32f) uniform writeonly image2D albedo;
layout(set = 0, binding = 18, rgba16f) uniform writeonly image2D emission;
layout(set = 0, binding = 19, rg32f) uniform writeonly image2D moments;
layout(set = 0, binding = 20, rgba16f) uniform writeonly image2D filterInput;
// Of the reflected images: xy of the specular layer, zw of the glass layer.
layout(set = 0, binding = 21, rgba32f) uniform readonly image2D reflectionMotion;
// What a reflection layer's history holds the light of (hybrid.glsl, encodeReflection),
// per pixel: as this pass wrote it the previous frame, and writes it now (see main).
layout(set = 0, binding = 22, rg32ui) uniform readonly uimage2D previousHistoryOf;
layout(set = 0, binding = 26, rg32ui) uniform writeonly uimage2D historyOf;
// What is reflected now, as reflectionMotion; of the pixels traced
// (TraceResolution::Half: the others borrow).
layout(set = 0, binding = 23, rgba32ui) uniform readonly uimage2D reflectionGuide;
// The layer's temporal gradients, filtered (hybrid.glsl, one per stratum): how
// much of its light changed since the previous frame.
layout(set = 0, binding = 24, rgba32f) uniform readonly image2D gradients;
// The specular layer: the sphere lights' highlights in closed form, as they are (x) and
// were (y) (direct.comp).
layout(set = 0, binding = 25, rg32f) uniform readonly image2D highlights;

// While moving, the history of the primary surfaces' sharp reflections is
// clamped to this many standard deviations around the mean of this frame's
// samples nearby (more for less sharp ones; clampToFrame). A wide range: rare bright samples of
// noisy reflected light (caustics) would be cut (darker), while the
// reflections the guides miss are far outside.
const float kReflectionDeviations = 6.0;

struct History
{
    vec4 color;  // rgb: mean, a: samples
    vec3 albedo;
    vec4 emission;  // a: the direct layer's frames of it
    vec2 moments;
};

bool isPrimary()
{
    return pass.layer == kLayerPrimary;
}

/** Whether the layer's light is divided by what the "albedo" images hold (primary, direct). */
bool demodulates()
{
    return pass.layer == kLayerPrimary || pass.layer == kLayerDirect;
}

/**
 * Whether the layer keeps a mean of what the "emission" images hold (the primary
 * layer's emission; the direct layer's unshadowed light of the last few frames).
 */
bool hasEmission()
{
    return pass.layer == kLayerPrimary || pass.layer == kLayerDirect;
}

// Of the direct layer's unshadowed light, the recent mean holds about the last this many
// frames (as many sample positions of the jitter) while things move; still, more and
// more, up to kStillUnshadowed.
const float kRecentUnshadowed = 4.0;
const float kStillUnshadowed = 1024.0;

/** Whether the layer is a reflection (glass, specular): reprojected with its image. */
bool reflects()
{
    return pass.layer == kLayerGlass || pass.layer == kLayerSpecular;
}

/** The previous camera's ray through a pixel position, at view depth 1. */
vec3 previousRay(vec2 position)
{
    vec2 size = viewportSize();
    return frameData.previousForward.xyz +
           frameData.previousRight.xyz * (2.0 * position.x / size.x - 1.0) +
           frameData.previousUp.xyz * (1.0 - 2.0 * position.y / size.y);
}

/**
 * Whether a previous-frame pixel saw the surface this pixel sees now: the
 * same instance, a similar normal, and its sample (at last frame's jitter)
 * on this sample's tangent plane, both where they were last frame. (Depths
 * alone would differ by the jitter on surfaces seen at grazing angles.)
 */
bool sameSurface(uvec4 current, vec3 previousPoint, vec3 normal, ivec2 tap, bool still)
{
    if (any(lessThan(tap, ivec2(0))) || any(greaterThanEqual(vec2(tap), viewportSize()))) {
        return false;
    }
    if (still) {
        // Nothing moved: the pixel's history is its own, edges included (the
        // jitter makes their surface alternate between frames).
        return true;
    }
    uvec4 previous = imageLoad(previousGuide, tap);
    if (previous.z != current.z || current.z == 0u) {
        return false;  // Another surface, or sky (no position to reproject).
    }
    vec3 tapPoint = frameData.previousPosition.xyz +
                    previousRay(vec2(tap) + frameData.previousJitter.xy) * guideDepth(previous);
    float viewDepth = dot(previousPoint - frameData.previousPosition.xyz,
                          frameData.previousForward.xyz);
    return abs(dot(normal, tapPoint - previousPoint)) <= 0.01 * viewDepth &&
           dot(guideNormal(previous), normal) > 0.9;
}

/** This layer's part of a reflection guide. */
uvec2 reflectionOf(uvec4 guide)
{
    return pass.layer == kLayerSpecular ? guide.xy : guide.zw;
}

History loadHistory(ivec2 tap)
{
    History h;
    h.color = imageLoad(previousColor, tap);
    h.moments = imageLoad(previousMoments, tap).xy;
    h.albedo = vec3(0.0);
    h.emission = vec4(0.0);
    if (demodulates()) {
        h.albedo = imageLoad(previousAlbedo, tap).rgb;
    }
    if (hasEmission()) {
        h.emission = imageLoad(previousEmission, tap);
    }
    return h;
}

/** Paths per traced pixel this frame (hybrid_trace.comp: as many of each layer). */
uint frameSamples()
{
    return max(1u, frameData.frame.z);
}

/** This frame's lighting divided by the albedo (direct: the unshadowed light), per channel. */
vec3 demodulated(vec3 radiance, vec3 surfaceAlbedo)
{
    if (pass.layer == kLayerDirect) {
        return radiance / demodulationUnshadowed(surfaceAlbedo);
    }
    return isPrimary() ? radiance / demodulationAlbedo(surfaceAlbedo) : radiance;
}

bool inside(ivec2 pixel)
{
    return all(greaterThanEqual(pixel, ivec2(0))) && all(lessThan(vec2(pixel), viewportSize()));
}

/** Whether a pixel near this one has samples of this frame on surface `key`. */
bool sampledOn(ivec2 tap, uint key)
{
    return inside(tap) && (!kBorrowing || tracedThisFrame(tap)) && imageLoad(guide, tap).z == key;
}

/**
 * Whether a pixel traced this frame around this one on the same surface (3x3; 5x5
 * where pixels borrow) reflects what a previous frame's pixel's history holds the light
 * of (`previous`).
 */
bool reflectedAround(ivec2 pixel, uint key, uvec2 previous)
{
    int radius = kBorrowing ? 2 : 1;
    for (int dy = -radius; dy <= radius; ++dy) {
        for (int dx = -radius; dx <= radius; ++dx) {
            ivec2 tap = pixel + ivec2(dx, dy);
            if ((dx != 0 || dy != 0) && sampledOn(tap, key) &&
                sameReflection(reflectionOf(imageLoad(reflectionGuide, tap)), previous)) {
                return true;
            }
        }
    }
    return false;
}

/**
 * Per-sample variance of the luminance, from this frame's samples around the
 * pixel (5x5, of the pixels traced) on the same surface.
 */
float spatialVariance(ivec2 pixel, uint key)
{
    float sum = 0.0;
    float squares = 0.0;
    float count = 0.0;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            ivec2 tap = pixel + ivec2(dx, dy);
            if (!sampledOn(tap, key)) {
                continue;
            }
            vec3 frameAlbedoTap = demodulates() ? imageLoad(frameAlbedo, tap).rgb : vec3(1.0);
            float l = luminance(demodulated(imageLoad(noisy, tap).rgb, frameAlbedoTap));
            sum += l;
            squares += l * l;
            count += 1.0;
        }
    }
    if (count <= 0.0) {
        return 0.0;
    }
    float mean = sum / count;
    // Neighbors hold means of frameSamples() samples: scale to one sample's variance.
    return max(0.0, squares / count - mean * mean) * float(frameSamples());
}

/**
 * Clamp a reflection's history to `deviations` standard deviations around the
 * mean of this frame's samples on the same surface around the pixel (5x5, of
 * the pixels traced): reflections the guides missed vanish at once where those
 * agree. Its moments move with it (the same variance).
 */
void clampToFrame(ivec2 pixel, uint key, float deviations, inout History history)
{
    vec3 sum = vec3(0.0);
    vec3 squares = vec3(0.0);
    float count = 0.0;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            ivec2 tap = pixel + ivec2(dx, dy);
            if (!sampledOn(tap, key)) {
                continue;
            }
            vec3 value = imageLoad(noisy, tap).rgb;
            sum += value;
            squares += value * value;
            count += 1.0;
        }
    }
    if (count <= 0.0) {
        return;
    }
    vec3 mean = sum / count;
    vec3 range = deviations * sqrt(max(squares / count - mean * mean, vec3(0.0)));
    vec3 clamped = clamp(history.color.rgb, mean - range, mean + range);
    float clampedLuminance = luminance(clamped);
    history.moments = vec2(clampedLuminance, history.moments.y -
                                                 history.moments.x * history.moments.x +
                                                 clampedLuminance * clampedLuminance);
    history.color.rgb = clamped;
}

/** Where a pixel's sample saw its surface (the guide's view depth along its ray). */
vec3 guidePoint(ivec2 pixel, uvec4 surface)
{
    vec3 direction = cameraDirection(vec2(pixel) + frameData.viewport.zw);
    return frameData.cameraPosition.xyz +
           direction * (guideDepth(surface) / dot(direction, frameData.cameraForward.xyz));
}

/** A traced pixel's samples as lent: the primary layer's divided by its albedo. */
vec4 lentSamples(ivec2 tap)
{
    vec4 value = imageLoad(noisy, tap);
    vec3 tapAlbedo = demodulates() ? imageLoad(frameAlbedo, tap).rgb : vec3(1.0);
    return vec4(demodulated(value.rgb, tapAlbedo), value.a);
}

/**
 * Whether a traced pixel (offset from the pixel, on surface `current` at
 * `point`) saw the same surface: the same instance, a similar normal, on its
 * tangent plane.
 */
bool sawSurface(uvec4 current, vec3 point, vec3 normal, ivec2 offset, ivec2 tap, uvec4 tapGuide)
{
    float tolerance = 0.01 * guideDepth(current) * length(vec2(offset));
    return tapGuide.z == current.z && dot(guideNormal(tapGuide), normal) >= 0.8 &&
           abs(dot(normal, guidePoint(tap, tapGuide) - point)) <= tolerance;
}

/**
 * A pixel not traced this frame (TraceResolution::Half, on surface `current`)
 * borrows from a traced pixel around it (3x3, two to four) that saw the same
 * surface: its reflections, and the pixel traced in its 2x2 block if it did
 * (mostly), else the nearest. With `average`, the samples of all of them,
 * nearer weighing more, into `lent` (the primary layer's divided by their
 * albedo). Where none saw it (a silhouette, a sliver): the traced pixel most
 * like it, on the same instance first (onSurface false). (-1, -1): none (no
 * surface, or only sky around).
 */
ivec2 borrow(ivec2 pixel, uvec4 current, bool average, out vec4 lent, out bool onSurface)
{
    lent = vec4(0.0);
    onSurface = false;
    if (current.z == 0u) {
        return ivec2(-1);
    }
    vec3 point = guidePoint(pixel, current);
    vec3 normal = guideNormal(current);
    if (!average) {
        ivec2 tap = currentlyTraced(pixel);
        if (inside(tap) && sawSurface(current, point, normal, tap - pixel, tap,
                                      imageLoad(guide, tap))) {
            onSurface = true;
            return tap;
        }
    }
    float weights = 0.0;
    float nearest = 0.0;
    ivec2 lender = ivec2(-1);
    float best = -1e9;
    ivec2 fallback = ivec2(-1);
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 offset = ivec2(dx, dy);
            ivec2 tap = pixel + offset;
            if (!inside(tap) || !tracedThisFrame(tap)) {
                continue;
            }
            uvec4 tapGuide = imageLoad(guide, tap);
            if (tapGuide.z == 0u) {
                continue;  // Sky: nothing to lend.
            }
            float distance = length(vec2(offset));
            float score = (tapGuide.z == current.z ? 4.0 : 0.0) +
                          dot(guideNormal(tapGuide), normal) - 0.1 * distance;
            if (score > best) {
                best = score;
                fallback = tap;
            }
            if (!sawSurface(current, point, normal, offset, tap, tapGuide)) {
                continue;
            }
            float w = 1.0 - distance / 2.0;
            if (average) {
                lent += w * lentSamples(tap);
            }
            weights += w;
            if (w > nearest) {
                nearest = w;
                lender = tap;
            }
        }
    }
    if (weights > 0.0) {
        lent /= weights;
        onSurface = true;
        return lender;
    }
    if (fallback.x >= 0 && average) {
        lent = lentSamples(fallback);
    }
    return fallback;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), viewportSize()))) {
        return;
    }
    uvec4 current = imageLoad(guide, pixel);
    vec4 currentMotion = imageLoad(motion, pixel);
    // This frame's samples (none of a pixel not traced, TraceResolution::Half).
    bool traced = !kBorrowing || tracedThisFrame(pixel);
    vec4 frameNoisy = traced ? imageLoad(noisy, pixel) : vec4(0.0);
    vec3 currentAlbedo = demodulates() ? imageLoad(frameAlbedo, pixel).rgb : vec3(0.0);
    vec3 currentEmission = hasEmission() ? imageLoad(frameEmission, pixel).rgb : vec3(0.0);
    bool reset = (frameData.history.y & kHistoryReset) != 0u;
    bool still = (frameData.history.y & kHistoryStatic) != 0u;
    uint cap = frameData.history.x;  // Frames; 0: still.
    float sharpness = reflects() && current.z != 0u ? reflectionSharpness(guideRoughness(current))
                                                    : 0.0;

    // What a reflection layer reflects: the motion of its image and its guide (of a
    // pixel not traced, its lender's).
    vec2 reflectedMotion = vec2(0.0);
    uvec2 reflection = uvec2(0u);
    if (reflects() && current.z != 0u) {
        vec4 unused;
        bool unusedOnSurface;
        ivec2 from = traced ? pixel : borrow(pixel, current, false, unused, unusedOnSurface);
        if (from.x >= 0) {
            vec4 reflected = imageLoad(reflectionMotion, from);
            reflectedMotion = pass.layer == kLayerSpecular ? reflected.xy : reflected.zw;
            reflection = reflectionOf(imageLoad(reflectionGuide, from));
        }
    }

    // Bilinear reprojection over the taps that saw the same surface.
    bool reprojected = false;  // Some taps saw the same surface.
    // What the history of a reflection layer will hold the light of (historyOf).
    uvec2 holds = reflection;
    History history;
    history.color = vec4(0.0);
    history.albedo = vec3(0.0);
    history.emission = vec4(0.0);
    history.moments = vec2(0.0);
    if (!reset && (isPrimary() || current.z != 0u)) {
        // This sample (at pixel + jitter) where it was last frame.
        vec3 previousPoint =
            frameData.previousPosition.xyz +
            previousRay(vec2(pixel) + frameData.viewport.zw + currentMotion.xy) * currentMotion.z;
        vec3 normal = current.z != 0u ? guideNormal(current) : vec3(0.0);
        // The history of a reflection is where its image was (on the same surface), if
        // that held the light of what this pixel reflects, or a pixel around it (sharp
        // reflections only: the mirror direction says little about glossy ones). At the
        // edge of a sharp reflection, what a pixel's sample reflects is either side, by the
        // jitter and the sample's ray (the edge of a light strip a canopy reflects): its
        // history is of both, and is kept while the ship flies on. What it holds the light
        // of stays what it was, though its samples are now of the other side: where the
        // reflection moved on, the history is dropped once that is not around any more
        // (else, of the other side then, it trailed behind a reflection on a moving pane).
        // A glossy reflection is a blurred image, its motion a guess (of a curved surface,
        // a poor one): it follows the surface, and its gradients tell what changed.
        vec2 moved = reflects() ? mix(currentMotion.xy, reflectedMotion, sharpness)
                                : currentMotion.xy;
        bool checkReflection = reflects() && !still && sharpness > 0.5;
        // Bilinear taps around the pixel center, moved.
        vec2 position = vec2(pixel) + 0.5 + moved - 0.5;
        ivec2 base = ivec2(floor(position));
        vec2 f = position - vec2(base);
        float weights[4] = float[](
            (1.0 - f.x) * (1.0 - f.y), f.x * (1.0 - f.y), (1.0 - f.x) * f.y, f.x * f.y);
        ivec2 offsets[4] = ivec2[](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1));
        // Which taps saw the same surface and, of a sharp reflection, held the light of what
        // this pixel reflects (1), else of what a pixel around it does (2; only if none
        // did 1: the history keeps the light of one of them).
        uint kept[4] = uint[](0u, 0u, 0u, 0u);
        bool own = false;
        float aroundWeight = 0.0;
        for (int i = 0; i < 4; ++i) {
            ivec2 tap = base + offsets[i];
            if (weights[i] <= 0.0 || !sameSurface(current, previousPoint, normal, tap, still)) {
                continue;
            }
            kept[i] = 1u;
            if (checkReflection) {
                uvec2 then = imageLoad(previousHistoryOf, tap).xy;
                if (sameReflection(reflection, then)) {
                    own = true;
                } else if (reflectedAround(pixel, current.z, then)) {
                    kept[i] = 2u;
                    if (weights[i] > aroundWeight) {
                        aroundWeight = weights[i];
                        holds = then;
                    }
                } else {
                    kept[i] = 0u;
                }
            }
        }
        if (own) {
            holds = reflection;
        }
        float total = 0.0;
        for (int i = 0; i < 4; ++i) {
            if (kept[i] != (own || !checkReflection ? 1u : 2u)) {
                continue;
            }
            ivec2 tap = base + offsets[i];
            History h = loadHistory(tap);
            history.color += weights[i] * h.color;
            history.albedo += weights[i] * h.albedo;
            history.emission += weights[i] * h.emission;

            history.moments += weights[i] * h.moments;
            total += weights[i];
        }
        if (total > 1e-3) {
            reprojected = true;
            history.color /= total;
            history.albedo /= total;
            history.emission /= total;

            history.moments /= total;
            if (cap > 0u && current.z != 0u) {
                // Of the light that changed, the history keeps that much less (A-SVGF):
                // all of it where a shadow moved on, or a highlight, or the sunlit patch
                // of a cockpit its canopy reflects.
                // (The direct layer's gradients are of how much of the light arrives.)
                vec4 gradient = imageLoad(gradients, pixel / kGradientStratum);
                vec3 lighting = pass.layer == kLayerDirect
                                    ? demodulated(history.color.rgb, history.albedo)
                                    : history.color.rgb;
                float change = gradientChange(gradient, current.z, luminance(lighting));
                if (pass.layer == kLayerSpecular) {
                    // The sphere lights' highlights as their closed forms tell (direct.comp):
                    // one sliding along a glossy surface (the sun along a canopy's frame as
                    // the ship turns) without the noise of samples; the samples' gradients,
                    // left the rest, count for less (kSampledSpecularChange).
                    vec2 highlight = imageLoad(highlights, pixel).xy;
                    float moved = abs(highlight.x - highlight.y) /
                                  max(max(max(highlight.x, highlight.y), luminance(lighting)), 1e-6);
                    change = max(kSampledSpecularChange * change,
                                 clamp(kGradientGain * moved, 0.0, 1.0));
                }
                history.color.a *= 1.0 - (reflects() ? min(change, kReflectionMaxChange) : change);
                if (sharpness > 0.0 && pass.layer == kLayerSpecular) {
                    clampToFrame(pixel, current.z, kReflectionDeviations / sharpness, history);
                }
            }
        } else {
            history.color = vec4(0.0);
            holds = reflection;
        }
    }

    if (reflects()) {
        imageStore(historyOf, pixel, uvec4(holds, 0u, 0u));
    }

    // Accumulate this frame's samples, if its paths were traced (of a pixel not
    // traced, TraceResolution::Half, the history waits for its own).
    float previousSamples = history.color.a;
    if (cap > 0u) {
        // Shorter history where the filter may not blur the lighting: what smooth
        // surfaces let through is a sharp image moving unlike them. (Reflections keep
        // all of it: they are reprojected from where their image was.)
        // The cap counts frames: more samples per frame make the history smoother
        // (and fewer pixels traced per frame, rougher).
        float strength = isPrimary() && current.z != 0u ? guideStrength(current, pass.layer) : 1.0;
        previousSamples = min(previousSamples, float(cap * frameSamples()) * traceRate() *
                                                   mix(0.25, 1.0, strength));
    }
    float frameWeight = traced ? float(frameSamples()) : 0.0;
    float samples = previousSamples + frameWeight;
    float weight = samples > 0.0 ? frameWeight / samples : 0.0;
    vec3 frameLighting = demodulated(frameNoisy.rgb, currentAlbedo);
    vec2 frameMoments = vec2(luminance(frameLighting), frameNoisy.a);
    // mean + (value - mean) * weight, not mix(): exact where the value is the mean.
    vec3 mean = history.color.rgb + (frameNoisy.rgb - history.color.rgb) * weight;
    vec3 meanAlbedo = history.albedo + (currentAlbedo - history.albedo) * weight;
    vec4 meanEmission =
        vec4(history.emission.rgb + (currentEmission - history.emission.rgb) * weight, 0.0);
    vec2 meanMoments = history.moments + (frameMoments - history.moments) * weight;
    if (samples <= 0.0) {
        // None yet: this frame's surface (lit by its neighbors' samples, below).
        meanAlbedo = currentAlbedo;
        meanEmission.rgb = currentEmission;
    }
    if (pass.layer == kLayerDirect) {
        // Every pixel's, every frame (traced or not), the history clamped to this frame's
        // around the pixel (3x3, as temporal anti-aliasing): where the light moved on, it
        // is where it is now; at an edge, the mean of both sides. (Its closed form has no
        // noise to mistake for change.) a: the frames it holds.
        vec3 low = currentEmission;
        vec3 high = currentEmission;
        vec3 m1 = vec3(0.0);
        vec3 m2 = vec3(0.0);
        for (int dy = -1; dy <= 1; ++dy) {
            for (int dx = -1; dx <= 1; ++dx) {
                ivec2 tap = clamp(pixel + ivec2(dx, dy), ivec2(0), ivec2(viewportSize()) - 1);
                vec3 value = imageLoad(frameEmission, tap).rgb;
                low = min(low, value);
                high = max(high, value);
                m1 += value;
                m2 += value * value;
            }
        }
        if ((frameData.options.x & kFlagDirectShadowMaps) != 0u) {
            // Shadowed (shadow maps), the light changes wherever the lights move, also
            // smoothly, where the range around a pixel holds the old value too: clamped to
            // the mean +- a standard deviation around it (variance clipping, Salvi), tight
            // where the light is smooth, as wide as the range at an edge.
            vec3 mean = m1 / 9.0;
            vec3 deviation = sqrt(max(m2 / 9.0 - mean * mean, vec3(0.0)));
            low = max(low, mean - deviation);
            high = min(high, mean + deviation);
        }
        float frames = reprojected ? min(history.emission.a + 1.0,
                                         still ? kStillUnshadowed : kRecentUnshadowed)
                                   : 1.0;
        vec3 recent = clamp(history.emission.rgb, low, high);
        meanEmission = vec4(recent + (currentEmission - recent) / frames, frames);
    }
    imageStore(color, pixel, vec4(mean, samples));
    imageStore(moments, pixel, vec4(meanMoments, 0.0, 0.0));
    if (demodulates()) {
        imageStore(albedo, pixel, vec4(meanAlbedo, 0.0));
    }
    if (hasEmission()) {
        imageStore(emission, pixel, meanEmission);
    }

    // Filter input: the lighting and the variance of its mean.
    if (samples <= 0.0) {
        // No sample of its own yet (not traced since it came into view): its
        // neighbors', as uncertain as one frame of theirs.
        vec4 lent = vec4(0.0);
        if (kBorrowing) {  // (Else every pixel has samples.)
            bool unusedOnSurface;
            borrow(pixel, current, true, lent, unusedOnSurface);
        }
        float spread = current.z != 0u ? spatialVariance(pixel, current.z) : 0.0;
        imageStore(filterInput, pixel, vec4(lent.rgb, spread / float(frameSamples())));
        return;
    }
    float variance = max(0.0, meanMoments.y - meanMoments.x * meanMoments.x);
    // A young history (new, or cut short by the gradients): its moments say little.
    if (previousSamples < 4.0 * float(frameSamples()) && current.z != 0u) {
        variance = max(variance, spatialVariance(pixel, current.z));
    }
    // A pixel not traced this frame (TraceResolution::Half) waits up to three frames
    // for samples of its own, showing its history: where the gradients cut that short
    // (the light changed), mostly light it no longer has. While things move, the samples
    // of its neighbors on the same surface (borrow) count as a frame of its own for the
    // filter (not for the history: its own samples only), so the less of its history is
    // left, the more of them it shows. Its variance stays the history's: the filter
    // averages those neighbors again.
    vec3 filterValue = demodulated(mean, meanAlbedo);
    if (kBorrowing && !traced && cap > 0u) {
        vec4 lent;
        bool onSurface;
        borrow(pixel, current, true, lent, onSurface);
        if (onSurface) {
            float lentSamples = float(frameSamples());
            filterValue += (lent.rgb - filterValue) * (lentSamples / (samples + lentSamples));
        }
    }
    imageStore(filterInput, pixel, vec4(filterValue, variance / samples));
}
