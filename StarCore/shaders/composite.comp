#version 460
// Hybrid renderer, composite: the direct light (how much of it arrives x the
// unshadowed light, direct.comp) + the rest of the primary lighting x albedo +
// emission + what the primary surfaces and the panes reflect (specular and glass
// layers) into the radiance image (tone mapped by post.comp), or a debug view of
// one of the intermediate images (raw ones: post.comp only clamps them).
// For ray reconstruction (kFlagRayReconstruction), this frame's samples but the glass
// layer's, which (filtered) is the overlay it adds, and the guides it takes.

#extension GL_GOOGLE_include_directive : require

#define STARCORE_NO_RAY_QUERY
#include "hybrid.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Bindings 0-2 and 4-6 are the scene's (hybrid.glsl, scene.glsl).
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D primaryLighting;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D glassLighting;
layout(set = 0, binding = 8, rgba32f) uniform readonly image2D albedo;
layout(set = 0, binding = 9, rgba16f) uniform readonly image2D emission;
layout(set = 0, binding = 10, rgba32f) uniform readonly image2D primaryHistory;
layout(set = 0, binding = 11, rgba32f) uniform readonly image2D noisyPrimary;
layout(set = 0, binding = 12, rgba32f) uniform readonly image2D noisyGlass;
layout(set = 0, binding = 13, rgba16f) uniform readonly image2D frameEmission;
layout(set = 0, binding = 14, rgba32f) uniform readonly image2D primaryMotion;
layout(set = 0, binding = 15, rgba32f) uniform writeonly image2D radianceImage;
layout(set = 0, binding = 16, rgba16f) uniform readonly image2D specularLighting;
layout(set = 0, binding = 17, rgba32f) uniform readonly image2D noisySpecular;
// The direct layer: how much of the light arrives (filtered), the unshadowed light of
// the last frames (temporal.comp), this frame's shadowed light.
layout(set = 0, binding = 18, rgba16f) uniform readonly image2D directVisibility;
layout(set = 0, binding = 19, rgba16f) uniform readonly image2D recentUnshadowed;
layout(set = 0, binding = 20, rgba32f) uniform readonly image2D noisyDirect;
// This frame's albedo and unshadowed light (kFlagUpscaled).
layout(set = 0, binding = 21, rgba16f) uniform readonly image2D frameAlbedo;
layout(set = 0, binding = 22, rgba16f) uniform readonly image2D frameUnshadowed;
// kFlagRayReconstruction: premultiplied, added to the result after denoising.
layout(set = 0, binding = 23, rgba16f) uniform writeonly image2D overlay;
// And its guides, of the primary surfaces (encodeGuide) past the panes in front (whose
// reflections it does not denoise): diffuse and specular albedo, world normal and roughness.
layout(set = 0, binding = 24, rgba32ui) uniform readonly uimage2D primaryGuide;
layout(set = 0, binding = 25, rgba16f) uniform writeonly image2D diffuseAlbedo;
layout(set = 0, binding = 26, rgba16f) uniform writeonly image2D specularAlbedo;
layout(set = 0, binding = 27, rgba16f) uniform writeonly image2D normalRoughness;

// HybridView.
const uint kViewFinal = 0u;
const uint kViewNoisy = 1u;
const uint kViewAlbedo = 2u;
const uint kViewDirect = 3u;
const uint kViewVisibility = 4u;
const uint kViewLighting = 5u;
const uint kViewSpecular = 6u;
const uint kViewGlass = 7u;
const uint kViewVariance = 8u;
const uint kViewMotion = 9u;
const uint kViewHistory = 10u;

/**
 * The mean reflectance of a GGX lobe over its directions (the DLSS-RR guide's fit, Ray Tracing
 * Gems chapter 32) of a surface whose reflectance head on is `f0`, `alpha` its roughness
 * squared.
 */
vec3 lobeAlbedo(vec3 f0, float alpha, float cosine)
{
    float c = abs(cosine);
    vec4 x = vec4(1.0, c, c * c, c * c * c);
    vec4 y = vec4(1.0, alpha, alpha * alpha, alpha * alpha * alpha);
    // Row vectors times the guide's (row major) matrices.
    float bias = dot(x.xy * mat2(0.99044, -1.28514, 1.29678, -0.755907), y.xy) /
                 dot(x.xyw * mat3(1.0, 2.92338, 59.4188, 20.3225, -27.0302, 222.592, 121.563,
                                  626.13, 316.627),
                     y.xyw);
    float scale = dot(x.xy * mat2(0.0365463, 3.32707, 9.0632, -9.04756), y.xy) /
                  dot(x.xzw * mat3(1.0, 3.59685, -1.36772, 9.04401, -16.3174, 9.22949, 5.56589,
                                   19.7886, -20.2123),
                      y.xyw);
    bias *= clamp(f0.g * 50.0, 0.0, 1.0);  // The guide's: none for no reflectance.
    return f0 * max(scale, 0.0) + max(bias, 0.0);
}

/**
 * Ray reconstruction's guides of a pixel: what its noisy light is made of. The light a
 * see-through surface lets through counts as diffuse, a blurred image of what is behind it.
 */
void writeReconstructionGuides(ivec2 pixel)
{
    uvec4 guide = imageLoad(primaryGuide, pixel);
    if (guide.z == 0u) {
        // The guide's defaults for the sky.
        imageStore(diffuseAlbedo, pixel, vec4(0.5, 0.5, 0.5, 0.0));
        imageStore(specularAlbedo, pixel, vec4(0.0));
        imageStore(normalRoughness, pixel, vec4(0.0));
        return;
    }
    Material surface = materialOf(guide.z - 1u);
    vec3 normal = guideNormal(guide);
    // This frame's albedo is past the panes in front (hybrid_trace.comp): their transmittance,
    // where the surface's albedo tells it, else their mean.
    vec3 seen = imageLoad(frameAlbedo, pixel).rgb;
    float meanTransmittance = imageLoad(frameEmission, pixel).a;
    vec3 transmittance;
    for (int c = 0; c < 3; ++c) {
        transmittance[c] =
            surface.albedo[c] > 0.01 ? seen[c] / surface.albedo[c] : meanTransmittance;
    }
    float f = (surface.ior - 1.0) / (surface.ior + 1.0);
    vec3 f0 = mix(vec3(f * f), surface.albedo.rgb, surface.metallic);
    vec3 direction = cameraDirection(vec2(pixel) + frameData.viewport.zw);
    vec3 specular = lobeAlbedo(f0, roughnessToAlpha(surface.roughness), dot(normal, -direction));
    imageStore(diffuseAlbedo, pixel, vec4((1.0 - surface.metallic) * seen, 0.0));
    imageStore(specularAlbedo, pixel, vec4(transmittance * specular, 0.0));
    imageStore(normalRoughness, pixel, vec4(normal, surface.roughness));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), viewportSize()))) {
        return;
    }
    vec4 lighting = imageLoad(primaryLighting, pixel);
    vec3 specular = imageLoad(specularLighting, pixel).rgb;
    vec3 glass = imageLoad(glassLighting, pixel).rgb;
    // With shadow maps the direct layer's light is shadowed already (its filter skipped).
    vec3 visibility = (frameData.options.x & kFlagDirectShadowMaps) != 0u
                          ? vec3(1.0)
                          : imageLoad(directVisibility, pixel).rgb;
    // The filtered lighting times the albedo and the unshadowed light of the last few
    // frames (they follow the lights, and edges stay anti-aliased: as many positions of
    // the jitter; still, of all of them) -- how much of the latter arrives is a share,
    // whatever the history holds of light that was brighter or dimmer then. Upscaled,
    // this frame's: the upscaler gathers its samples into the output's pixels.
    bool upscaled = (frameData.options.x & kFlagUpscaled) != 0u;
    vec3 surfaceAlbedo =
        upscaled ? imageLoad(frameAlbedo, pixel).rgb : imageLoad(albedo, pixel).rgb;
    vec3 unshadowed = upscaled ? imageLoad(frameUnshadowed, pixel).rgb
                               : imageLoad(recentUnshadowed, pixel).rgb;
    vec3 surfaceEmission =
        upscaled ? imageLoad(frameEmission, pixel).rgb : imageLoad(emission, pixel).rgb;
    vec3 direct = demodulationUnshadowed(unshadowed) * visibility;
    vec3 radiance = direct + demodulationAlbedo(surfaceAlbedo) * lighting.rgb + surfaceEmission +
                    specular + glass;
    if ((frameData.options.x & kFlagRayReconstruction) != 0u) {
        // Every pixel traced (traceStride 1).
        radiance = imageLoad(frameEmission, pixel).rgb + imageLoad(noisyDirect, pixel).rgb +
                   imageLoad(noisyPrimary, pixel).rgb + imageLoad(noisySpecular, pixel).rgb;
        imageStore(overlay, pixel, vec4(glass, 0.0));
        writeReconstructionGuides(pixel);
    }

    switch (frameData.history.z) {
    case kViewNoisy:
        // This frame's samples (TraceResolution::Half: of the pixels traced, the others black).
        radiance = imageLoad(frameEmission, pixel).rgb;
        if (tracedThisFrame(pixel)) {
            radiance += imageLoad(noisyDirect, pixel).rgb + imageLoad(noisyPrimary, pixel).rgb +
                        imageLoad(noisySpecular, pixel).rgb + imageLoad(noisyGlass, pixel).rgb;
        }
        break;
    case kViewAlbedo:  // Raw.
        radiance = surfaceAlbedo;
        break;
    case kViewDirect:
        radiance = direct;
        break;
    case kViewVisibility:  // Raw.
        radiance = visibility;
        break;
    case kViewLighting:
        radiance = lighting.rgb;
        break;
    case kViewSpecular:
        radiance = specular;
        break;
    case kViewGlass:
        radiance = glass;
        break;
    case kViewVariance:  // Raw.
        radiance = vec3(sqrt(lighting.a) / max(1e-4, luminance(lighting.rgb)));
        break;
    case kViewMotion:  // Raw.
        radiance = vec3(abs(imageLoad(primaryMotion, pixel).xy) / 8.0, 0.0);
        break;
    case kViewHistory: {  // Raw.
        // The cap in samples (still: 64 frames).
        uint frames = frameData.history.x != 0u ? frameData.history.x : 64u;
        float cap = float(frames * max(1u, frameData.frame.z)) * traceRate();
        radiance = vec3(imageLoad(primaryHistory, pixel).a / cap);
        break;
    }
    default:
        break;
    }
    imageStore(radianceImage, pixel, vec4(radiance, 1.0));
}
