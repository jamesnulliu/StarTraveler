#version 460
// Auto exposure, first pass: the frame's radiance (before exposure) into a histogram of the log2
// of its brightest channel (exposure.glsl), counted per workgroup in shared memory first. Not of
// its luminance: film saturates channel by channel, and a sky of deep blue, of little luminance,
// would be exposed until its blue is lost.

#extension GL_GOOGLE_include_directive : require

#include "exposure.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D radiance;
layout(set = 0, binding = 1, std430) buffer Histogram
{
    uint bins[kExposureBins];
}
histogram;

shared uint counts[kExposureBins];

void main()
{
    uint index = gl_LocalInvocationIndex;
    if (index < kExposureBins) {
        counts[index] = 0u;
    }
    barrier();
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (all(lessThan(pixel, imageSize(radiance)))) {
        vec3 color = imageLoad(radiance, pixel).rgb;
        atomicAdd(counts[exposureBin(max(color.r, max(color.g, color.b)))], 1u);
    }
    barrier();
    if (index < kExposureBins && counts[index] != 0u) {
        atomicAdd(histogram.bins[index], counts[index]);
    }
}
