#version 460
// Raster pipeline, shading pass: the rasterized first hits (visibility
// buffers) lit like RenderMode::Preview -- sky, ambient light, a headlight and
// the sphere lights -- with no ray traced: the lights' shadows are looked up
// in their shadow maps (soft, shadows.glsl), the preview's are hard; the
// nearest thin transmissive surface in front (the glass layer) is blended over
// what it covers, as the preview does with its first layer. Jittered frames
// are averaged while nothing changes (anti-aliasing, smoother penumbras);
// post.comp tone maps the mean. Also writes the motion vectors of the nearest
// surface (motion blur).

#extension GL_GOOGLE_include_directive : require

#define STARCORE_NO_RAY_QUERY
#include "hybrid.glsl"
#include "shadows.glsl"
#include "sky.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// Bindings 1-2 and 4-6 are the scene's (hybrid.glsl, scene.glsl).
layout(set = 0, binding = 3, rg32ui) uniform readonly uimage2D visibility;
layout(set = 0, binding = 7, rg32ui) uniform readonly uimage2D glassVisibility;
// rgb = sum of the frames' radiance, a = frame count.
layout(set = 0, binding = 8, rgba32f) uniform image2D accumulation;
layout(set = 0, binding = 9, rgba32f) uniform writeonly image2D radianceImage;  // Their mean.
layout(set = 0, binding = 10, r32ui) uniform writeonly uimage2D entityIds;
// xy: where the surface was a frame ago minus where it is (pixels), z: its view
// depth then, w: now (as the hybrid's).
layout(set = 0, binding = 11, rgba32f) uniform writeonly image2D motion;
// GpuScene::previousTransformBuffer().
layout(set = 0, binding = 12, std430) readonly buffer PreviousTransforms
{
    InstanceTransform previousTransforms[];
};

/** Irradiance of a sphere light at a hit, unshadowed (0: below its horizon, or a mesh). */
vec3 sphereIrradiance(Light light, SurfaceHit hit)
{
    if (light.triangleCount > 0u) {
        return vec3(0.0);  // Meshes: their own emission only.
    }
    vec3 toCenter = light.center - hit.position;
    float distance2 = dot(toCenter, toCenter);
    if (distance2 <= light.radius * light.radius) {
        return vec3(0.0);
    }
    float cosine = dot(toCenter / sqrt(distance2), hit.normal);
    return cosine <= 0.0 ? vec3(0.0)
                         : light.emission * (cosine * light.radius * light.radius / distance2);
}

// Lights adding less than this fraction of a point's light skip the shadow
// test: their shadows would hardly show.
const float kFaintLight = 0.02;

/**
 * Irradiance at a hit: shadePreview's (path.glsl), shadows from the shadow
 * maps; `rotation` turns the pattern of their taps.
 */
vec3 irradianceAt(SurfaceHit hit, vec3 direction, float rotation)
{
    vec3 irradiance = skyAmbientOf(frameData.sky.xy) + vec3(kPreviewAmbient) +
                      vec3(kPreviewHeadlight * max(0.0, -dot(hit.normal, direction)));
    uint count = frameData.options.z;
    vec3 unshadowed = irradiance;
    for (uint i = 0u; i < count; ++i) {
        unshadowed += sphereIrradiance(lights[i], hit);
    }
    float faint = kFaintLight * luminance(unshadowed);
    for (uint i = 0u; i < count; ++i) {
        Light light = lights[i];
        vec3 lightIrradiance = sphereIrradiance(light, hit);
        if (luminance(lightIrradiance) > faint) {
            lightIrradiance *= shadowVisibility(i, light.center, light.radius, hit.position,
                                                hit.geometricNormal, rotation);
        }
        irradiance += lightIrradiance;
    }
    return irradiance;
}

/** The hit of the camera ray with the surface of a visibility buffer texel. */
bool surfaceHit(uvec2 ids, vec3 origin, vec3 direction, out SurfaceHit hit, out vec3 objectPoint)
{
    objectPoint = vec3(0.0);
    return ids.x != 0u && reconstructHit(ids.x - 1u, ids.y, origin, direction, hit, objectPoint);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(vec2(pixel), viewportSize()))) {
        return;
    }
    vec3 origin = frameData.cameraPosition.xyz;
    vec3 direction = cameraDirection(vec2(pixel) + frameData.viewport.zw);

    SurfaceHit primary;
    vec3 primaryPoint;
    bool hasPrimary =
        surfaceHit(imageLoad(visibility, pixel).xy, origin, direction, primary, primaryPoint);
    SurfaceHit pane;
    vec3 panePoint;
    bool hasPane =
        surfaceHit(imageLoad(glassVisibility, pixel).xy, origin, direction, pane, panePoint) &&
        (!hasPrimary || pane.t < primary.t);
    // w: the view depth (motion blur).
    imageStore(motion, pixel,
               hasPrimary ? vec4(screenMotion(primary.instanceIndex,
                                              previousTransforms[primary.instanceIndex].objectToWorld,
                                              primaryPoint)
                                     .xyz,
                                 primary.t * dot(direction, frameData.cameraForward.xyz))
                          : vec4(0.0, 0.0, 0.0, kFar));

    // Interleaved gradient noise (Jimenez 2014): neighbors' taps differ, and
    // averaged frames turn them on.
    float rotation =
        kTwoPi * fract(52.9829189 * fract(dot(vec2(pixel), vec2(0.06711056, 0.00583715))) +
                       0.618034 * float(frameData.frame.x));
    vec3 radiance = skyRadianceOf(frameData.sky.xy, direction);
    uint entityId = kNoEntityId;
    if (hasPrimary) {
        Material material = materialOf(primary.instanceIndex);
        radiance = material.emission.rgb +
                   material.albedo.rgb * irradianceAt(primary, direction, rotation);
        entityId = instances[primary.instanceIndex].entityId;
    }
    if (hasPane) {
        Material material = materialOf(pane.instanceIndex);
        float transmitted = (1.0 - material.metallic) * material.transmission;
        radiance = material.emission.rgb +
                   material.albedo.rgb *
                       (irradianceAt(pane, direction, rotation) * (1.0 - transmitted) +
                        transmitted * radiance);
        if (!isSeeThrough(material)) {
            entityId = instances[pane.instanceIndex].entityId;
        }
    }

    bool reset = (frameData.history.y & kHistoryReset) != 0u;
    vec4 accumulated = (reset ? vec4(0.0) : imageLoad(accumulation, pixel)) + vec4(radiance, 1.0);
    imageStore(accumulation, pixel, accumulated);
    imageStore(radianceImage, pixel, vec4(accumulated.rgb / accumulated.a, 1.0));
    if ((frameData.options.x & kFlagWriteIds) != 0u) {
        imageStore(entityIds, pixel, uvec4(entityId));
    }
}
