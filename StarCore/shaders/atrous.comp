#version 460
// Hybrid renderer, spatial filter: one iteration of the edge-avoiding a-trous
// wavelet filter of SVGF (Schied et al., HPG 2017) on the primary lighting.
//
// 5x5 taps `step` pixels apart, weighted by the B3 spline kernel and stopped
// at edges: other instances, normals that differ, depths off the center's
// tangent plane, and luminance differences beyond what the variance of the
// mean explains. As samples accumulate that variance goes to 0, and with it
// the blur: a still image converges to the unfiltered mean.

#extension GL_GOOGLE_include_directive : require

#define STARCORE_NO_RAY_QUERY
#include "hybrid.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform Pass
{
    int step;
    uint firstIteration;  // Blur the variance (later iterations get it filtered).
}
pass;

// Bindings 0-2 and 4-6 are the scene's (hybrid.glsl, scene.glsl).
layout(set = 0, binding = 3, rgba32ui) uniform readonly uimage2D guide;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D inputImage;
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D outputImage;
layout(set = 0, binding = 9, rg32ui) uniform readonly uimage2D filterGuide;

bool inside(ivec2 pixel)
{
    return all(greaterThanEqual(pixel, ivec2(0))) && all(lessThan(vec2(pixel), viewportSize()));
}

/** Variance blurred over the 3x3 neighbors on the same surface (steadier edge stopping). */
float blurredVariance(ivec2 pixel, uint key)
{
    const float kernel[2] = float[](0.25, 0.125);
    float sum = 0.0;
    float weights = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 tap = pixel + ivec2(dx, dy);
            if (!inside(tap) || filterKey(imageLoad(filterGuide, tap).xy) != key) {
                continue;
            }
            float w = kernel[abs(dx)] * kernel[abs(dy)];
            sum += w * imageLoad(inputImage, tap).a;
            weights += w;
        }
    }
    return sum / weights;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (!inside(pixel)) {
        return;
    }
    vec4 center = imageLoad(inputImage, pixel);
    uvec2 centerGuide = imageLoad(filterGuide, pixel).xy;
    uint key = filterKey(centerGuide);
    float strength = key != 0u ? guideStrength(imageLoad(guide, pixel)) : 0.0;
    if (strength <= 0.0) {
        imageStore(outputImage, pixel, center);
        return;
    }

    float colorSigma = frameData.denoiser.x;
    float normalPower = frameData.denoiser.y;
    float depthSigma = frameData.denoiser.z;
    vec3 normal = filterNormal(centerGuide);
    float depth = uintBitsToFloat(centerGuide.x);

    // On the center's tangent plane, the view depth through pixel offset
    // (dx, dy) is planeDepth / (c + a dx + b dy): the camera ray (forward +
    // right * ndcX + up * ndcY, at view depth 1) is affine in the pixel. The
    // depths are this frame's, at the jittered sample positions.
    vec2 size = viewportSize();
    vec2 ndc = vec2(2.0, -2.0) * (vec2(pixel) + frameData.viewport.zw) / size + vec2(-1.0, 1.0);
    vec3 ray = frameData.cameraForward.xyz + frameData.cameraRight.xyz * ndc.x +
               frameData.cameraUp.xyz * ndc.y;
    float c = dot(normal, ray);
    float a = dot(normal, frameData.cameraRight.xyz) * 2.0 / size.x;
    float b = -dot(normal, frameData.cameraUp.xyz) * 2.0 / size.y;
    float planeDepth = depth * c;
    // Depth change across a pixel at this depth and angle, scaled by the tolerance.
    float pixelSize = depth * 2.0 * length(frameData.cameraUp.xyz) / size.y;
    float depthScale = depthSigma * pixelSize / max(abs(c) / length(ray), 0.05);

    float variance = pass.firstIteration != 0u ? blurredVariance(pixel, key) : center.a;
    float centerLuminance = luminance(center.rgb);
    float luminanceTolerance = colorSigma * sqrt(max(0.0, variance)) + 1e-10;

    const float kernel[3] = float[](1.0, 2.0 / 3.0, 1.0 / 6.0);
    vec3 sum = center.rgb;
    float varianceSum = center.a;
    float weights = 1.0;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            if (dx == 0 && dy == 0) {
                continue;
            }
            vec2 offset = vec2(dx, dy) * float(pass.step);
            ivec2 tap = pixel + ivec2(offset);
            if (!inside(tap)) {
                continue;
            }
            uvec2 tapGuide = imageLoad(filterGuide, tap).xy;
            float denominator = c + a * offset.x + b * offset.y;
            if (filterKey(tapGuide) != key || denominator * c <= 0.0) {
                continue;
            }
            vec4 value = imageLoad(inputImage, tap);
            float depthError = abs(uintBitsToFloat(tapGuide.x) - planeDepth / denominator);
            float w = kernel[abs(dx)] * kernel[abs(dy)] * strength *
                      pow(max(0.0, dot(normal, filterNormal(tapGuide))), normalPower) *
                      exp(-depthError / (depthScale * length(offset)) -
                          abs(luminance(value.rgb) - centerLuminance) / luminanceTolerance);
            sum += w * value.rgb;
            varianceSum += w * w * value.a;
            weights += w;
        }
    }
    imageStore(outputImage, pixel, vec4(sum / weights, varianceSum / (weights * weights)));
}
