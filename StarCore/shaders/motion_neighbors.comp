#version 460
// Motion blur, neighborhood pass: the largest tile blur among each tile and
// its eight neighbors (what may smear into the tile from outside).

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D tiles;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D neighbors;

void main()
{
    ivec2 tile = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(tiles);
    if (any(greaterThanEqual(tile, size))) {
        return;
    }
    vec2 largest = vec2(0.0);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 v = imageLoad(tiles, clamp(tile + ivec2(x, y), ivec2(0), size - 1)).xy;
            if (dot(v, v) > dot(largest, largest)) {
                largest = v;
            }
        }
    }
    imageStore(neighbors, tile, vec4(largest, 0.0, 0.0));
}
