# Compile commands: build/mingw/compile_commands.json (`cmake --preset mingw`), which already has
# the project's warnings (adding -Wall/-Wextra after them would turn its -Wno-... back on).
CompileFlags:
  Remove:
    - -fconcepts-diagnostics-depth=*
    - -fmodules*
    - -fmodule-mapper*
    - -fdeps-format*
    - /MP
    # clangd cannot build the std module: StarCore's module units use #include instead
    - -DSTARCORE_IMPORT_STD

Index:
  Background: Build
  StandardLibrary: Yes

Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None

  ClangTidy:
    Add: [
      performance-*,
      modernize-*,
      clang-analyzer-*,
      readability-*,
    ]

    Remove: [
      readability-isolate-declaration,
      readability-identifier-length,
      readability-magic-numbers,
      readability-function-cognitive-complexity,
      modernize-avoid-c-arrays,
      readability-math-missing-parentheses,
      readability-uppercase-literal-suffix,
      # Not this code's style: leading return types, positional aggregate initialization, and
      # the trailing-comma check of clang-tidy 22+ (it asks for and against them both)
      modernize-use-trailing-return-type,
      modernize-use-designated-initializers,
      readability-trailing-comma,
    ]

    CheckOptions:
      readability-identifier-naming.VariableCase: aNy_CasE
      readability-identifier-naming.ProtectedMemberCase: aNy_CasE
      readability-identifier-naming.PrivateMemberCase: aNy_CasE
      readability-identifier-naming.PublicMemberCase: aNy_CasE
      readability-identifier-naming.NamespaceCase: lower_case
      readability-identifier-naming.EnumCase: aNy_CasE
      readability-identifier-naming.ClassCase: CamelCase
      readability-identifier-naming.StructCase: aNy_CasE
      readability-identifier-naming.FunctionCase: aNy_CasE
      readability-identifier-naming.ClassMethodCase: aNy_CasE
