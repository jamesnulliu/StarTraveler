#version 460
// Hybrid renderer, trace pass: path tracing from the rasterized first hits.
//
// Three layers per pixel, each with its own guides (depth, normal, instance)
// and motion vectors for the temporal and spatial filters:
//   - primary: the first surface that is not clear glass (visibility buffer).
//     Paths start there (path.glsl, so the estimator is the reference's);
//     its albedo and emission are kept apart so its lighting can be
//     filtered without blurring surface detail.
//   - specular: what the primary surface reflects, if it is smooth enough
//     (hasSpecularLayer). Its paths then sample the other lobes; the
//     reflection is traced as a path of its own into this layer.
//   - glass: the nearest smooth window pane in front of it (glass visibility
//     buffer). Paths are split there: the straight-through part continues to
//     the primary surface with the pane's expected transmittance, the other
//     lobes (reflections) are traced as their own path into this layer.
//
// Four stages, each a pipeline of its own (kStage): the surfaces every pixel
// sees (guides, motion, albedo, emission); the primary layer's paths; the
// reflected paths, one per pixel, frame and layer (their layers keep their own
// history), a fixed cost outside the samples per pixel, often the expensive
// ones (from a cockpit's canopy back into the cockpit); and, while things
// move, the temporal gradients of the primary lighting (traceGradient). Paths
// are traced from every pixel, or from one of each 2x2 in turn (traceStride,
// TraceResolution::Half; the others borrow, temporal.comp).
// Reflections do not move with the surfaces reflecting them: their motion
// vectors follow the reflected image (virtualMotion) of what their sample
// reflected.

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require

#include "hybrid.glsl"
#include "path.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

const uint kStageSamples = 0u;      // The traced pixels: the primary layer's paths.
const uint kStageReflections = 1u;  // The traced pixels: the reflected paths.
const uint kStageGradients = 2u;    // One invocation per gradient stratum.
const uint kStageSurfaces = 3u;     // Every pixel: guides, motion, albedo, emission, ids.

// A pipeline per stage: each holds only its stage's code (as one shader, all
// stages would get the registers of the most demanding: many paths inlined).
layout(constant_id = 0) const uint kStage = kStageSamples;

layout(set = 0, binding = 3, rg32ui) uniform readonly uimage2D visibility;
layout(set = 0, binding = 7, rg32ui) uniform readonly uimage2D glassVisibility;
// rgb: this frame's mean radiance, a: mean squared (demodulated) luminance;
// samples per pixel paths for the primary layer, one for the others.
layout(set = 0, binding = 8, rgba32f) uniform writeonly image2D noisyPrimary;
layout(set = 0, binding = 9, rgba32f) uniform writeonly image2D noisyGlass;
// Primary surface albedo and emission (both after the glass in front of it).
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D frameAlbedo;
layout(set = 0, binding = 11, rgba16f) uniform writeonly image2D frameEmission;
layout(set = 0, binding = 12, rgba32ui) uniform writeonly uimage2D primaryGuide;
layout(set = 0, binding = 13, rgba32f) uniform writeonly image2D primaryMotion;
layout(set = 0, binding = 14, rgba32ui) uniform writeonly uimage2D glassGuide;
layout(set = 0, binding = 15, rgba32f) uniform writeonly image2D glassMotion;
layout(set = 0, binding = 16, r32ui) uniform writeonly uimage2D entityIds;
layout(set = 0, binding = 17, rg32ui) uniform writeonly uimage2D primaryFilterGuide;
layout(set = 0, binding = 18, rg32ui) uniform writeonly uimage2D glassFilterGuide;
// GpuScene::previousTransformBuffer(): the instances' transforms of the previous frame.
layout(set = 0, binding = 19, std430) readonly buffer PreviousTransforms
{
    InstanceTransform previousTransforms[];
};
layout(set = 0, binding = 20, rgba32f) uniform writeonly image2D noisySpecular;
// Screen motion of the reflected images: xy of the specular layer, zw of the glass layer.
layout(set = 0, binding = 21, rgba32f) uniform writeonly image2D reflectionMotion;
// What is reflected, for the temporal pass to tell (encodeReflection): xy of the
// specular layer, zw of the glass layer.
layout(set = 0, binding = 22, rgba32ui) uniform writeonly uimage2D reflectionGuide;
// What the samples of the primary layer started from, for the next frame's
// gradients: the visibility (instance + 1, primitive; the path vertices before
// it in the top 8 bits of x), and the luminance of the direct light the first
// path found there (-1: none).
layout(set = 0, binding = 23, rg32ui) uniform readonly uimage2D previousHits;
layout(set = 0, binding = 24, rg32ui) uniform writeonly uimage2D hits;
layout(set = 0, binding = 25, r32f) uniform readonly image2D previousDirectLight;
layout(set = 0, binding = 26, r32f) uniform writeonly image2D directLight;
// One per stratum (hybrid.glsl, kGradientStratum).
layout(set = 0, binding = 27, rgba32f) uniform writeonly image2D gradients;

// The sky, reflected: this far away, where it does not move.
const float kReflectedSky = 1e5;

uint instanceMask()
{
    return frameData.options.y;
}

uint lightCount()
{
    return frameData.options.z;
}

vec3 skyColor()
{
    return frameData.skyColor.rgb;
}

uint maxBounces()
{
    return frameData.frame.w;
}

bool nextEventEnabled()
{
    return (frameData.options.x & kFlagNextEvent) != 0u;
}

float fireflyClamp()
{
    return frameData.cameraForward.w;
}

float viewDepth(SurfaceHit hit, vec3 direction)
{
    return hit.t * dot(direction, frameData.cameraForward.xyz);
}

vec4 motionOf(uint instanceIndex, vec3 objectPoint)
{
    return screenMotion(instanceIndex, previousTransforms[instanceIndex].objectToWorld,
                        objectPoint);
}

/** A world point that moves with an instance, where it was in the previous frame. */
vec3 previousPosition(uint instanceIndex, vec3 point)
{
    return transformPoint(previousTransforms[instanceIndex].objectToWorld,
                          transformPoint(transforms[instanceIndex].worldToObject, point));
}

/** The rasterized first hits of a pixel's camera ray (with the pane only if in front). */
void firstHits(ivec2 pixel, vec3 origin, vec3 direction, out bool hasPrimary,
               out SurfaceHit primary, out vec3 primaryPoint, out bool hasPane,
               out SurfaceHit pane, out vec3 panePoint)
{
    uvec2 opaque = imageLoad(visibility, pixel).xy;
    hasPrimary = opaque.x != 0u &&
                 reconstructHit(opaque.x - 1u, opaque.y, origin, direction, primary,
                                primaryPoint);
    uvec2 glass = imageLoad(glassVisibility, pixel).xy;
    hasPane = glass.x != 0u &&
              reconstructHit(glass.x - 1u, glass.y, origin, direction, pane, panePoint) &&
              (!hasPrimary || pane.t < primary.t);
}

/**
 * What the primary surface (at distance primaryT) is seen through: the
 * expected transmittance of the panes in front of it, their emission, and the
 * path vertices they take (panes are vertices too: bounce limits as the
 * reference).
 */
void throughPanes(bool hasPane, SurfaceHit pane, float primaryT, vec3 direction,
                  out vec3 transmittance, out vec3 emission, out uint bounces)
{
    transmittance = vec3(1.0);
    emission = vec3(0.0);
    bounces = 0u;
    if (!hasPane) {
        return;
    }
    Material material = materialOf(pane.instanceIndex);
    emission += material.emission.rgb;
    transmittance = thinTransmittance(material, abs(dot(direction, pane.geometricNormal)));
    bounces = 1u;
    // Further panes before the primary surface (rare): their expected transmittance;
    // what they reflect is left out.
    vec3 position = offsetOrigin(pane.position, pane.geometricNormal, direction);
    float remaining = primaryT - pane.t;
    for (int layer = 1; layer < kMaxThinLayers && maxComponent(transmittance) > 0.0; ++layer) {
        SurfaceHit next;
        if (!traceClosestHit(position, direction, instanceMask(), remaining * 0.9999, next)) {
            break;
        }
        Material nextMaterial = materialOf(next.instanceIndex);
        if (!isGlassLayer(nextMaterial)) {
            break;  // The rasterizer and the ray disagree: trust the rasterizer.
        }
        emission += transmittance * nextMaterial.emission.rgb;
        transmittance *=
            thinTransmittance(nextMaterial, abs(dot(direction, next.geometricNormal)));
        position = offsetOrigin(next.position, next.geometricNormal, direction);
        remaining -= next.t;
        ++bounces;
    }
}

/**
 * Curvature (1 / radius) of the surface at a hit as the ray sees it: > 0
 * convex, < 0 concave. Spheres: exact; meshes: how the vertex normals of the
 * triangle turn along its edges (0 without them: flat).
 */
float curvatureAt(SurfaceHit hit, uint primitive)
{
    uint index = hit.instanceIndex;
    Instance instance = instances[index];
    float side = hit.frontFace ? 1.0 : -1.0;
    if (instance.kind == kGeometrySphere) {
        vec3 center = transformPoint(transforms[index].objectToWorld, vec3(0.0));
        return side / max(distance(hit.position, center), 1e-6);
    }
    if (instance.normals == uvec2(0u)) {
        return 0.0;
    }
    uvec3 i = triangleIndices(instance, primitive);
    mat3 worldToObject = linearPart(transforms[index].worldToObject);
    vec3 p[3];
    vec3 n[3];
    for (int k = 0; k < 3; ++k) {
        p[k] = transformPoint(transforms[index].objectToWorld, loadVec3(instance.positions, i[k]));
        n[k] = normalize(loadVec3(instance.normals, i[k]) * worldToObject);
    }
    float sum = 0.0;
    for (int k = 0; k < 3; ++k) {
        vec3 edge = p[(k + 1) % 3] - p[k];
        sum += dot(n[(k + 1) % 3] - n[k], edge) / max(dot(edge, edge), 1e-12);
    }
    return side * sum / 3.0;
}

/**
 * Screen motion (xy, pixels) of what a surface reflects along a camera ray:
 * of the reflection's virtual image, on the ray behind the surface at the
 * reflected ray's hit distance as the curvature focuses it (the mirror
 * equation). The image moves with the surface and mirrors how the reflected
 * point moves relative to it. The reflected ray is the sample's (`sampled`; the
 * mirror direction if it has none): a sample of a sharp reflection that strays
 * onto something else (a bright ball beside the mirror direction's sky) is that
 * reflection's, moves with it and is told apart by it. `reflection`: what the
 * ray hits (encodeReflection).
 */
vec2 virtualMotion(SurfaceHit surface, uint primitive, vec3 direction, vec3 sampled,
                   out uvec2 reflection)
{
    vec3 ray = sampled;
    if (ray == vec3(0.0)) {
        ray = reflect(direction, surface.normal);
        if (dot(ray, surface.geometricNormal) <= 0.0) {
            ray = reflect(direction, surface.geometricNormal);
        }
    }
    float reach = kReflectedSky;
    vec3 reflected = surface.position + ray * reach;
    vec3 previous = reflected;
    SurfaceHit hit;
    reflection = encodeReflection(reach, 0u);
    if (traceClosestHit(offsetOrigin(surface.position, surface.geometricNormal, ray), ray,
                        instanceMask(), hit)) {
        reach = hit.t;
        reflected = hit.position;
        previous = previousPosition(hit.instanceIndex, reflected);
        reflection = encodeReflection(reach, hit.instanceIndex + 1u);
    }
    if ((frameData.history.y & kHistoryStatic) != 0u) {
        return vec2(0.0);  // Exactly.
    }
    uint index = surface.instanceIndex;
    // How far the reflected point moved relative to the surface since the previous frame.
    vec3 carried = transformPoint(transforms[index].objectToWorld,
                                  transformPoint(previousTransforms[index].worldToObject, previous));
    vec3 relative = reflected - carried;
    float magnification = 1.0 / max(1.0 + 2.0 * curvatureAt(surface, primitive) * reach, 1e-3);
    vec3 image = surface.position + direction * min(reach * magnification, kReflectedSky);
    vec3 then = projectPrevious(
        previousPosition(index, image - magnification * reflect(relative, surface.normal)));
    if (then.z <= 0.0) {
        return vec2(1e9);  // Behind the previous camera: off screen.
    }
    return then.xy - projectCurrent(image).xy;
}

/** The traced pixels: the paths reflected by the primary surface and the pane in front of it. */
void traceReflections(ivec2 pixel, vec3 origin, vec3 direction)
{
    bool hasPrimary;
    SurfaceHit primary;
    vec3 primaryPoint;
    bool hasPane;
    SurfaceHit pane;
    vec3 panePoint;
    firstHits(pixel, origin, direction, hasPrimary, primary, primaryPoint, hasPane, pane,
              panePoint);
    bool preview = (frameData.options.x & kFlagPreview) != 0u;
    vec4 motion = vec4(0.0);
    uvec4 reflected = uvec4(0u);

    // The pane's reflection (layer 0, the glass layer's), and the primary surface's
    // seen through the pane (layer 1, the specular layer's).
    bool glass = hasPane && !preview;
    Material surface;
    if (hasPrimary) {
        surface = materialOf(primary.instanceIndex);
    }
    bool reflecting = hasPrimary && !preview && hasSpecularLayer(surface);
    vec3 transmittance = vec3(0.0);
    uint bounce = 0u;
    if (reflecting) {
        vec3 emission;
        throughPanes(hasPane, pane, primary.t, direction, transmittance, emission, bounce);
    }
    bool specular = reflecting && bounce < maxBounces() && maxComponent(transmittance) > 0.0;
    vec4 results[2] = vec4[](vec4(0.0), vec4(0.0));
    vec3 rays[2] = vec3[](vec3(0.0), vec3(0.0));  // The samples' reflected rays (0: none).
    // One loop for both: a single copy of the path code (see tracePathFrom).
    [[dont_unroll]] for (int layer = 0; layer < 2; ++layer) {
        if (layer == 0 ? !glass : !specular) {
            continue;
        }
        // A random stream of its own.
        uint rng = rngForPixel(uint(pixel.x), uint(pixel.y), frameData.frame.x,
                               pcgHash(frameData.frame.y ^ (layer == 0 ? 0x68e31da4u : 0x2c1b3c6du)));
        PathState path = newPath();
        vec3 firstRadiance;
        tracePathFrom(layer == 0 ? pane : primary, direction, layer == 0 ? 0u : bounce,
                      maxBounces(),
                      kVertexSkipEmission |
                          (layer == 0 ? kLobesReflection | kLobesDiffuse : kLobesReflection),
                      path, rng, firstRadiance, rays[layer]);
        vec3 radiance = (layer == 0 ? vec3(1.0) : transmittance) * path.radiance;
        float l = luminance(radiance);
        results[layer] = vec4(radiance, l * l);
    }
    if (glass) {
        uvec2 reflection;
        motion.zw = virtualMotion(pane, imageLoad(glassVisibility, pixel).y, direction, rays[0],
                                  reflection);
        reflected.zw = reflection;
    }
    if (reflecting) {
        uvec2 reflection;
        motion.xy = virtualMotion(primary, imageLoad(visibility, pixel).y, direction, rays[1],
                                  reflection);
        reflected.xy = reflection;
    }
    imageStore(noisyGlass, pixel, results[0]);
    imageStore(noisySpecular, pixel, results[1]);
    imageStore(reflectionMotion, pixel, motion);
    imageStore(reflectionGuide, pixel, reflected);
}

bool movedSince(uint instanceIndex)
{
    for (int row = 0; row < 3; ++row) {
        if (any(notEqual(transforms[instanceIndex].objectToWorld[row],
                         previousTransforms[instanceIndex].objectToWorld[row]))) {
            return true;
        }
    }
    return false;
}

/**
 * The temporal gradient at a pixel (A-SVGF, Schied et al., HPG 2018): the
 * direct light the first path of the previous frame's sample on this pixel's
 * surface found, found again from the same surface point (moved with its
 * instance) with the same random numbers (the same point on the same light),
 * in the scene as it is now. Where nothing changed it comes out the same, so
 * the (absolute) difference is what changed (a shadow that moved on), none of
 * the noise. Only the direct light: the rest of a path bounces off into the
 * scene, and of a surface moving through it (a cockpit) every one comes out
 * different although its lighting hardly changes; the history would be cut
 * short for nothing. (The primary layer's paths do not depend on where the
 * camera is: their reflections are the specular layer's.)
 */
vec4 gradientAt(ivec2 pixel)
{
    uvec2 opaque = imageLoad(visibility, pixel).xy;
    if (opaque.x == 0u) {
        return vec4(0.0);
    }
    uint instanceIndex = opaque.x - 1u;
    vec4 none = vec4(0.0, 0.0, 0.0, uintBitsToFloat(opaque.x));
    // The previous frame's pixel where this sample's surface point was.
    SurfaceHit hit;
    vec3 objectPoint;
    if (!reconstructHit(instanceIndex, opaque.y, frameData.cameraPosition.xyz,
                        cameraDirection(vec2(pixel) + frameData.viewport.zw), hit, objectPoint)) {
        return none;
    }
    ivec2 previous = ivec2(floor(vec2(pixel) + frameData.viewport.zw +
                                 motionOf(instanceIndex, objectPoint).xy));
    if (any(lessThan(previous, ivec2(0)))) {
        return none;
    }
    // Of the pixels around, the one that had a path then.
    previous = previouslyTraced(previous);
    if (any(greaterThanEqual(vec2(previous), viewportSize()))) {
        return none;
    }
    float before = imageLoad(previousDirectLight, previous).x;
    uvec2 previousHit = imageLoad(previousHits, previous).xy;
    if (before < 0.0 || (previousHit.x & 0xFFFFFFu) != opaque.x) {
        return none;  // No path then, or another surface.
    }
    // That sample's camera ray, with its instance as it is now.
    vec3 origin = frameData.previousPosition.xyz;
    vec3 direction = previousCameraDirection(vec2(previous) + frameData.previousJitter.xy);
    if (movedSince(instanceIndex)) {
        origin = transformPoint(transforms[instanceIndex].objectToWorld,
                                transformPoint(previousTransforms[instanceIndex].worldToObject,
                                               frameData.previousPosition.xyz));
        direction = normalize(transformVector(
            transforms[instanceIndex].objectToWorld,
            transformVector(previousTransforms[instanceIndex].worldToObject, direction)));
    }
    if (!reconstructHit(instanceIndex, previousHit.y, origin, direction, hit, objectPoint)) {
        return none;
    }
    Material surface = materialOf(instanceIndex);
    uint lobes = hasSpecularLayer(surface) ? kLobesDiffuse | kLobesTransmission : 0u;
    uint bounce = previousHit.x >> 24;
    // main()'s stream of that pixel and frame, whose first path it was.
    uint rng = rngForPixel(uint(previous.x), uint(previous.y), frameData.frame.x - 1u,
                           frameData.frame.y);
    PathState path = newPath();
    vec3 nextOrigin;
    vec3 nextDirection;
    pathVertex(hit, surface, instances[instanceIndex].lightIndex, direction, bounce,
               kVertexSkipEmission | lobes, path, rng, nextOrigin, nextDirection);
    float now = luminance(path.radiance);
    return vec4(abs(now - before), max(now, before), 1.0, none.w);
}

/** Third stage: the gradient of a stratum, at one of its pixels (another each frame). */
void traceGradient(ivec2 stratum)
{
    uint k = pcgHash(frameData.frame.x) % uint(kGradientStratum * kGradientStratum);
    ivec2 pixel = stratum * kGradientStratum +
                  ivec2(k % uint(kGradientStratum), k / uint(kGradientStratum));
    vec4 gradient = vec4(0.0);
    if (all(lessThan(vec2(pixel), viewportSize()))) {
        gradient = gradientAt(pixel);
    }
    imageStore(gradients, stratum, gradient);
}

/**
 * What the primary surface is seen through (throughPanes), and its albedo and
 * emission past it (the sky's emission if there is none).
 */
void primaryThroughPanes(bool hasPrimary, SurfaceHit primary, Material surface, bool hasPane,
                         SurfaceHit pane, vec3 direction, out vec3 transmittance,
                         out vec3 albedo, out vec3 emission, out uint bounces)
{
    throughPanes(hasPane, pane, hasPrimary ? primary.t : kFar, direction, transmittance, emission,
                 bounces);
    albedo = vec3(0.0);
    if (hasPrimary) {
        albedo = transmittance * surface.albedo.rgb;
        emission += transmittance * surface.emission.rgb;
    } else {
        emission += transmittance * skyColor();
    }
}

/** Every pixel: the ids, guides, motion, albedo and emission of what it sees. */
void writeSurfaces(ivec2 pixel, vec3 origin, vec3 direction)
{
    uint flags = frameData.options.x;
    bool hasPrimary;
    SurfaceHit primary;
    vec3 primaryPoint;
    bool hasPane;
    SurfaceHit pane;
    vec3 panePoint;
    firstHits(pixel, origin, direction, hasPrimary, primary, primaryPoint, hasPane, pane,
              panePoint);
    Material surface;
    if (hasPrimary) {
        surface = materialOf(primary.instanceIndex);
    }

    if ((flags & kFlagWriteIds) != 0u) {
        uint id = kNoEntityId;
        if (hasPrimary) {
            // Rough see-through panes are primary surfaces; ids look through them.
            id = isSeeThrough(surface)
                     ? firstOpaqueEntity(
                           offsetOrigin(primary.position, primary.geometricNormal, direction),
                           direction)
                     : instances[primary.instanceIndex].entityId;
        }
        imageStore(entityIds, pixel, uvec4(id));
    }

    // Guides and motion ---------------------------------------------------------------------------
    if (hasPrimary) {
        float depth = viewDepth(primary, direction);
        imageStore(primaryGuide, pixel,
                   encodeGuide(depth, primary.normal, primary.instanceIndex,
                               lightingStrength(surface), surface.roughness));
        imageStore(primaryFilterGuide, pixel,
                   uvec4(encodeFilterGuide(depth, primary.normal, primary.instanceIndex), 0u,
                         0u));
        // w: the view depth (motion blur).
        imageStore(primaryMotion, pixel,
                   vec4(motionOf(primary.instanceIndex, primaryPoint).xyz, depth));
    } else {
        imageStore(primaryGuide, pixel, uvec4(0u));
        imageStore(primaryFilterGuide, pixel, uvec4(0u));
        imageStore(primaryMotion, pixel, vec4(0.0, 0.0, 0.0, kFar));
    }
    if (hasPane) {
        float depth = viewDepth(pane, direction);
        // What panes reflect is filtered fully: the reflections of a cockpit are mostly
        // soft, and sharp, bright ones stop the filter by their luminance.
        imageStore(glassGuide, pixel,
                   encodeGuide(depth, pane.normal, pane.instanceIndex, 1.0,
                               materialOf(pane.instanceIndex).roughness));
        imageStore(glassFilterGuide, pixel,
                   uvec4(encodeFilterGuide(depth, pane.normal, pane.instanceIndex), 0u, 0u));
        imageStore(glassMotion, pixel, motionOf(pane.instanceIndex, panePoint));
    } else {
        imageStore(glassGuide, pixel, uvec4(0u));
        imageStore(glassFilterGuide, pixel, uvec4(0u));
        imageStore(glassMotion, pixel, vec4(0.0));
    }

    if ((flags & kFlagPreview) != 0u) {
        // Deterministic: all of it is "emission" (no lighting to filter).
        imageStore(frameAlbedo, pixel, vec4(0.0));
        imageStore(frameEmission, pixel, vec4(shadePreview(origin, direction), 0.0));
        return;
    }
    vec3 transmittance;
    vec3 albedo;
    vec3 emission;
    uint bounces;
    primaryThroughPanes(hasPrimary, primary, surface, hasPane, pane, direction, transmittance,
                        albedo, emission, bounces);
    imageStore(frameAlbedo, pixel, vec4(albedo, 0.0));
    imageStore(frameEmission, pixel, vec4(emission, 0.0));
}

/** The traced pixels: the primary layer's paths. */
void traceSamples(ivec2 pixel, vec3 origin, vec3 direction)
{
    if ((frameData.options.x & kFlagPreview) != 0u) {
        imageStore(noisyPrimary, pixel, vec4(0.0));
        imageStore(hits, pixel, uvec4(0u));
        imageStore(directLight, pixel, vec4(-1.0));
        return;
    }
    uint samples = max(1u, frameData.frame.z);
    uint rng = rngForPixel(uint(pixel.x), uint(pixel.y), frameData.frame.x, frameData.frame.y);
    bool hasPrimary;
    SurfaceHit primary;
    vec3 primaryPoint;
    bool hasPane;
    SurfaceHit pane;
    vec3 panePoint;
    firstHits(pixel, origin, direction, hasPrimary, primary, primaryPoint, hasPane, pane,
              panePoint);
    Material surface;
    if (hasPrimary) {
        surface = materialOf(primary.instanceIndex);
    }
    vec3 transmittance;
    vec3 albedo;
    vec3 emission;
    uint primaryBounce;
    primaryThroughPanes(hasPrimary, primary, surface, hasPane, pane, direction, transmittance,
                        albedo, emission, primaryBounce);
    vec3 demodulation = 1.0 / demodulationAlbedo(albedo);

    vec3 sum = vec3(0.0);
    float squares = 0.0;
    // The first path's direct light, for the next frame's gradients (gradientAt).
    float firstLight = -1.0;
    if (hasPrimary && primaryBounce < maxBounces() && maxComponent(transmittance) > 0.0) {
        // The reflection is the specular layer's (traceReflections).
        uint lobes = hasSpecularLayer(surface) ? kLobesDiffuse | kLobesTransmission : 0u;
        for (uint s = 0u; s < samples; ++s) {
            PathState path = newPath();
            vec3 firstRadiance;
            vec3 firstDirection;
            tracePathFrom(primary, direction, primaryBounce, maxBounces(),
                          kVertexSkipEmission | lobes, path, rng, firstRadiance, firstDirection);
            if (s == 0u) {
                firstLight = luminance(firstRadiance);
            }
            vec3 radiance = transmittance * path.radiance;
            sum += radiance;
            float l = luminance(radiance * demodulation);
            squares += l * l;
        }
    }
    imageStore(noisyPrimary, pixel, vec4(sum, squares) / float(samples));
    uvec2 opaque = imageLoad(visibility, pixel).xy;
    imageStore(hits, pixel, uvec4(opaque.x | (min(primaryBounce, 255u) << 24), opaque.y, 0u, 0u));
    imageStore(directLight, pixel, vec4(firstLight));
}

void main()
{
    ivec2 thread = ivec2(gl_GlobalInvocationID.xy);
    if (kStage == kStageGradients) {
        if (all(lessThan(thread, imageSize(gradients)))) {
            traceGradient(thread);
        }
        return;
    }
    // Surfaces: a thread per pixel; paths: per block of traceStride()^2 pixels,
    // for the one traced this frame.
    ivec2 pixel = kStage == kStageSurfaces ? thread : tracedPixel(thread);
    if (any(greaterThanEqual(vec2(pixel), viewportSize()))) {
        return;
    }
    vec3 origin = frameData.cameraPosition.xyz;
    vec3 direction = cameraDirection(vec2(pixel) + frameData.viewport.zw);
    if (kStage == kStageSurfaces) {
        writeSurfaces(pixel, origin, direction);
    } else if (kStage == kStageReflections) {
        traceReflections(pixel, origin, direction);
    } else {
        traceSamples(pixel, origin, direction);
    }
}