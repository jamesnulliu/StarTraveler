* text=auto eol=lf

# Windows batch files must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.hdr binary
*.exr binary
*.ttf binary
*.spv binary
*.glb binary
*.bin binary

# Preserve exported evidence bytes, hashes and original capture log formatting.
/renders/** -text -whitespace
/docs/final-materials/** -text -whitespace
