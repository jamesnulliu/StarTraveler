#version 460
// GPU path tracer: one invocation per pixel, ray queries against the TLAS.
// Port of CpuPathTracer::renderTiles (src/render/path_tracer.cpp) -- same
// estimator (path.glsl), same random streams, so the two converge to the same
// image. Keep them in sync.

#extension GL_GOOGLE_include_directive : require

#include "path.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

// rgb = sum of samples, a = sample count (frames may differ in samples per pixel).
layout(set = 0, binding = 1, rgba32f) uniform image2D accumulation;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D outputImage;
layout(set = 0, binding = 3, r32ui) uniform writeonly uimage2D entityIds;

const uint kFlagPreview = 1u;
const uint kFlagNextEvent = 2u;
const uint kFlagSrgb = 4u;
const uint kFlagWriteIds = 8u;

/** gpu::PathTraceParams (112 bytes). */
layout(push_constant) uniform Params
{
    vec4 cameraPosition;  // w: exposure
    vec4 cameraForward;   // w: firefly clamp (0 = off)
    vec4 cameraRight;     // right * aspect * tan(fov / 2)
    vec4 cameraUp;        // up * tan(fov / 2)
    vec4 skyColor;
    uvec4 frame;    // frame index, seed, samples per pixel, max bounces
    uvec4 options;  // flags, instance mask, light count, tone mapper
}
params;

uint instanceMask()
{
    return params.options.y;
}

uint lightCount()
{
    return params.options.z;
}

vec3 skyColor()
{
    return params.skyColor.rgb;
}

uint maxBounces()
{
    return params.frame.w;
}

bool nextEventEnabled()
{
    return (params.options.x & kFlagNextEvent) != 0u;
}

float fireflyClamp()
{
    return params.cameraForward.w;
}

void main()
{
    uvec2 size = uvec2(imageSize(outputImage));
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }
    uint flags = params.options.x;
    bool preview = (flags & kFlagPreview) != 0u;
    bool writeIds = (flags & kFlagWriteIds) != 0u;
    uint samples = preview ? 1u : max(1u, params.frame.z);
    uint frameIndex = params.frame.x;
    uint rng = rngForPixel(pixel.x, pixel.y, frameIndex, params.frame.y);

    vec3 origin = params.cameraPosition.xyz;
    vec3 color = vec3(0.0);
    uint entityId = kNoEntityId;
    for (uint s = 0u; s < samples; ++s) {
        // Jittered position in the pixel: anti-aliasing for free.
        vec2 position = vec2(pixel) + vec2(nextFloat(rng), nextFloat(rng));
        float ndcX = 2.0 * position.x / float(size.x) - 1.0;
        float ndcY = 1.0 - 2.0 * position.y / float(size.y);  // Pixel +y is down.
        vec3 direction = normalize(params.cameraForward.xyz + params.cameraRight.xyz * ndcX +
                                   params.cameraUp.xyz * ndcY);
        if (s == 0u && writeIds) {
            entityId = firstOpaqueEntity(origin, direction);
        }
        color += preview ? shadePreview(origin, direction) : tracePath(origin, direction, rng);
    }

    vec4 accumulated = frameIndex == 0u ? vec4(0.0) : imageLoad(accumulation, ivec2(pixel));
    accumulated += vec4(color, float(samples));
    imageStore(accumulation, ivec2(pixel), accumulated);

    vec3 display = toneMap(accumulated.rgb / accumulated.a * params.cameraPosition.w,
                           params.options.w);
    if ((flags & kFlagSrgb) != 0u) {
        display = linearToSrgb(display);
    }
    // Quantize like packRgba8 (round half up) whatever rounding the GPU uses for UNORM stores.
    vec3 quantized = floor(clamp(display, 0.0, 1.0) * 255.0 + 0.5);
    imageStore(outputImage, ivec2(pixel), vec4((quantized + 0.25) / 255.0, 1.0));
    if (writeIds) {
        imageStore(entityIds, ivec2(pixel), uvec4(entityId));
    }
}
