{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 30,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "STARCORE_CXX_STANDARD": "23"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja Multi-Config",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux"
            }
        },
        {
            "name": "msvc",
            "displayName": "MSVC - Visual Studio 2026 (MSBuild)",
            "inherits": "windows-base",
            "generator": "Visual Studio 18 2026",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "set"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
            }
        },
        {
            "name": "msvc-python",
            "displayName": "MSVC + Python bindings (in-tree, uses .venv)",
            "description": "Builds starcore._core into StarCore/python/starcore for `pytest` without installing",
            "inherits": "msvc",
            "cacheVariables": {
                "STARCORE_BUILD_PYTHON": "ON",
                "Python_EXECUTABLE": "${sourceDir}/.venv/Scripts/python.exe"
            }
        },
        {
            "name": "msvc-vs2022",
            "displayName": "MSVC - Visual Studio 2022 (MSBuild)",
            "inherits": "msvc",
            "generator": "Visual Studio 17 2022"
        },
        {
            "name": "msvc-ninja",
            "displayName": "MSVC + Ninja (run inside a VS Developer shell, see scripts/build.ps1)",
            "inherits": "windows-base",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl",
                "CMAKE_CXX_COMPILER": "cl",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
            }
        },
        {
            "name": "mingw",
            "displayName": "MinGW-w64 GCC + Ninja",
            "inherits": "windows-base",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
                "VCPKG_HOST_TRIPLET": "x64-mingw-static",
                "STARCORE_BUILD_PYTHON": "OFF"
            }
        },
        {
            "name": "linux-gcc",
            "displayName": "Linux GCC + Ninja",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++"
            }
        },
        {
            "name": "linux-clang",
            "displayName": "Linux Clang + Ninja",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        }
    ],
    "buildPresets": [
        { "name": "msvc-debug",          "configurePreset": "msvc",        "configuration": "Debug" },
        { "name": "msvc-release",        "configurePreset": "msvc",        "configuration": "Release" },
        { "name": "msvc-relwithdebinfo", "configurePreset": "msvc",        "configuration": "RelWithDebInfo" },
        { "name": "msvc-python-release", "configurePreset": "msvc-python", "configuration": "Release" },
        { "name": "msvc-vs2022-debug",   "configurePreset": "msvc-vs2022", "configuration": "Debug" },
        { "name": "msvc-vs2022-release", "configurePreset": "msvc-vs2022", "configuration": "Release" },
        { "name": "msvc-ninja-debug",    "configurePreset": "msvc-ninja",  "configuration": "Debug" },
        { "name": "msvc-ninja-release",  "configurePreset": "msvc-ninja",  "configuration": "Release" },
        { "name": "mingw-debug",         "configurePreset": "mingw",       "configuration": "Debug" },
        { "name": "mingw-release",       "configurePreset": "mingw",       "configuration": "Release" },
        { "name": "linux-gcc-debug",     "configurePreset": "linux-gcc",   "configuration": "Debug" },
        { "name": "linux-gcc-release",   "configurePreset": "linux-gcc",   "configuration": "Release" },
        { "name": "linux-clang-debug",   "configurePreset": "linux-clang", "configuration": "Debug" },
        { "name": "linux-clang-release", "configurePreset": "linux-clang", "configuration": "Release" }
    ],
    "testPresets": [
        { "name": "msvc-debug",        "configurePreset": "msvc",        "configuration": "Debug",   "output": { "outputOnFailure": true } },
        { "name": "msvc-release",      "configurePreset": "msvc",        "configuration": "Release", "output": { "outputOnFailure": true } },
        { "name": "msvc-ninja-debug",  "configurePreset": "msvc-ninja",  "configuration": "Debug",   "output": { "outputOnFailure": true } },
        { "name": "mingw-debug",       "configurePreset": "mingw",       "configuration": "Debug",   "output": { "outputOnFailure": true } },
        { "name": "mingw-release",     "configurePreset": "mingw",       "configuration": "Release", "output": { "outputOnFailure": true } },
        { "name": "linux-gcc-debug",   "configurePreset": "linux-gcc",   "configuration": "Debug",   "output": { "outputOnFailure": true } },
        { "name": "linux-clang-debug", "configurePreset": "linux-clang", "configuration": "Debug",   "output": { "outputOnFailure": true } }
    ]
}
