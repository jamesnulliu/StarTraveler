// starcore.common -- what the rest of the engine builds on:
//
//   :enum_names  names of enum values (EnumNames, enumToString, enumFromString)
//   :format      std::formatter for glm vectors and quaternions
//   :image       2D pixel buffers (Image2D, ColorImage, IdImage) and PNG output
//   :parallel    a thread pool for parallel-for jobs
//   :version     the engine version (generated by CMake)
//
// Logging and assertions are macros (SC_INFO, SC_ASSERT, ...), which modules
// cannot export: they stay the headers starcore/common/log.hpp and assert.hpp.

export module starcore.common;

export import :enum_names;
export import :format;
export import :image;
export import :parallel;
export import :version;
